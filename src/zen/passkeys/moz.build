# Touch ID + keychain helpers for the passkey authenticator in
# dom/webauthn/authrs_bridge/src/zen_touchid.rs.
if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    SOURCES += [
        "ZenPasskeysNative.mm",
    ]

    LOCAL_INCLUDES += [
        "/security/manager/ssl",
    ]

FINAL_LIBRARY = "xul"
